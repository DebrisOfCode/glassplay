{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlassPlay",
  "version": "1.1.0",
  "identifier": "com.glassplay.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GlassPlay",
        "width": 1280,
        "height": 780,
        "minWidth": 860,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#05060a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
